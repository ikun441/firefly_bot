# ==============================================================================
# 流萤 Firefly · 敏感配置模板
# ------------------------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 .env       cp .env.example .env
#   2. 填入真实的密钥与令牌
#   3. .env 已被 .gitignore 忽略，切勿提交到版本库
#
# 本文件中的值会覆盖 config.yaml 中的同名非敏感配置（若存在）。
# 环境变量优先级：真实环境变量 > .env 文件 > config.yaml 默认值
# ==============================================================================

# ------------------------------------------------------------------------------
# 大语言模型 API Key（必填其一）
# ------------------------------------------------------------------------------
# DeepSeek: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 若使用其他供应商，可通过这些变量单独覆盖（不填则复用上面的 LLM_API_KEY）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 可选：独立的 OCR 服务密钥
# 若留空，则截图解析走多模态 LLM（需 llm.model 支持视觉）
# ------------------------------------------------------------------------------
OCR_API_KEY=
OCR_BASE_URL=

# ------------------------------------------------------------------------------
# OneBot v11 协议端连接配置
# ------------------------------------------------------------------------------
# 本项目采用【反向 WebSocket】，连接方向是「协议端 → 流萤」：
#
#     NapCat（客户端） ──连接──▶  流萤（服务端）
#                                    ws://127.0.0.1:2525/onebot/v11/ws
#
# 因此协议端一侧要「新建 WebSocket 客户端」并填上面的地址，
# 而不是让流萤去连协议端。
#
# 正反向连接共用此令牌做鉴权，留空表示不校验。
# 若填写，协议端那边的 Token 必须与本项完全一致。
ONEBOT_ACCESS_TOKEN=

# 正向 WS 地址（流萤作为客户端主动连协议端）。
# ⚠️ 使用反向 WS 时必须留空 —— 填了会与上面的架构冲突，
#    表现为 AggregateError [ECONNREFUSED] 反复重连。
ONEBOT_WS_URL=

# 反向 WS 监听路径，需与协议端配置一致。
# 完整地址 = http://<server.host>:<server.port> + 本路径
ONEBOT_WS_PATH=/onebot/v11/ws

# 超级用户 QQ 号，多个用英文逗号分隔，例如：123456789,987654321
# 注意：请为不使用的项**保持注释状态**。
# NoneBot 会在启动早期直接读取本文件并对 SUPERUSERS 做 JSON 解析，
# 留一个空的 SUPERUSERS= 会导致：
#   SettingsError: error parsing env var "superusers"
# SUPERUSERS=123456789,987654321

# ------------------------------------------------------------------------------
# 数据库（若需覆盖 config.yaml 中的 url）
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./data/firefly.db

# ------------------------------------------------------------------------------
# 可选：天气/汇率等扩展 API（预留）
# ------------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=


# ------------------------------------------------------------------------------
# 安全提示：本文件若曾提交过真实密钥，请立即到各平台后台吊销并重新生成
# ------------------------------------------------------------------------------
